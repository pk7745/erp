# BMS College ERP Environment Configuration Example
SECRET_KEY=bms_erp_secret_key_2026
PORT=5000

# Supabase PostgreSQL Cloud Database Connection URL
DATABASE_URL=postgresql://postgres:<your_db_password>@db.<your_supabase_project>.supabase.co:5432/postgres

# Gmail SMTP Email Notification Credentials (Required for Live Email Dispatch)
MAIL_USERNAME=your_official_email@gmail.com
MAIL_PASSWORD=your_16_char_gmail_app_password

# Gemini AI Assistant API Key (Optional)
# GEMINI_API_KEY=your_gemini_api_key_here

# Internal Assessment Maximum Marks (Default: 20.0 per BMS College policy)
IA1_MAX_MARKS=20.0
IA2_MAX_MARKS=20.0
FINAL_IA_MAX_MARKS=20.0

# ==============================================================================
# BMSCCM CAMPUS-ONLY TEACHER ATTENDANCE GEOFENCE CONFIGURATION
# Institution: BMS College of Commerce & Management (BMSCCM)
# Address: No. 97, Kavi Lakshmisha Road, Parvathi Nagar / V.V. Puram, Bengaluru - 560004
# (Distinct from BMS College of Engineering, Basavanagudi)
# ==============================================================================
CAMPUS_GEOFENCE_ENABLED=True
CAMPUS_GEOFENCE_MODE=RADIUS
